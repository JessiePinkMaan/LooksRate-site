# =============================================================================
# LoxRate — пример окружения. Скопируй в .env и заполни.
# Реальные секреты в репозиторий НЕ коммитить (см. .gitignore).
# =============================================================================

# --- Приложение -------------------------------------------------------------
NODE_ENV=development
SITE_URL=http://localhost:3000
APP_TIMEZONE=Europe/Moscow
AGE_GATE_MIN=18

# --- База данных (PostgreSQL 16) --------------------------------------------
DATABASE_URL=postgresql://loxrate:loxrate@localhost:5432/loxrate?schema=public

# --- Redis (кэш, капы, очереди) ---------------------------------------------
REDIS_URL=redis://localhost:6379

# --- S3 / MinIO (локальное хранилище видео и ассетов) -----------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=loxrate
S3_SECRET_ACCESS_KEY=loxrate-secret
S3_BUCKET_VIDEO=loxrate-video
S3_BUCKET_ASSETS=loxrate-assets
S3_FORCE_PATH_STYLE=true

# --- Telegram ---------------------------------------------------------------
# Отдельный бот для входа/оплаты (НЕ @loxrate_bot). Создать через @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=loxrate_auth_bot
# live | fake — fake использует локальную исходящую очередь + /dev/outbox
TELEGRAM_MODE=fake
# live | fixture — fixture берёт content/ru/telegram-feed.fixture.json
TELEGRAM_FEED_MODE=fixture
# Через запятую. Только этим tg_id при входе выдаётся role=OWNER.
OWNER_TELEGRAM_IDS=

# --- Сессии и dev-вход ------------------------------------------------------
# Минимум 32 символа. В проде — сгенерировать случайно.
SESSION_SECRET=dev-only-session-secret-change-me-please
# true — включает /dev/login. Не работает при NODE_ENV=production.
DEV_LOGIN=true

# --- Видео ------------------------------------------------------------------
# local | mux | cloudflare
VIDEO_PROVIDER=local
# Мастер-ключ шифрования HLS-ключей (AES-128). Минимум 32 символа.
VIDEO_KEY_MASTER=dev-only-video-key-master-change-me

# --- Платежи ----------------------------------------------------------------
# Список включённых провайдеров через запятую: stars,fake,...
PAYMENT_PROVIDERS=fake

# --- Наблюдаемость ----------------------------------------------------------
SENTRY_DSN=
