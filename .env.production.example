# =============================================================================
# LoxRate - production environment template.
# Copy to .env on the server. Never commit the filled file.
# All CHANGE_ME values must be replaced before `docker compose ... up`.
# =============================================================================

NODE_ENV=production
SITE_URL=https://CHANGE_ME.example
APP_TIMEZONE=Europe/Moscow
AGE_GATE_MIN=18

# --- PostgreSQL (docker-compose.prod.yml) -----------------------------------
POSTGRES_USER=loxrate
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=loxrate
DATABASE_URL=postgresql://loxrate:CHANGE_ME_STRONG_DB_PASSWORD@postgres:5432/loxrate?schema=public

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://redis:6379

# --- MinIO / S3-compatible storage ------------------------------------------
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=CHANGE_ME_S3_ACCESS_KEY
S3_SECRET_ACCESS_KEY=CHANGE_ME_S3_SECRET_KEY
S3_BUCKET_VIDEO=loxrate-video
S3_BUCKET_ASSETS=loxrate-assets
S3_FORCE_PATH_STYLE=true

# --- Telegram ---------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=loxrate_auth_bot
TELEGRAM_MODE=live
TELEGRAM_FEED_MODE=fixture
OWNER_TELEGRAM_IDS=CHANGE_ME_TELEGRAM_ID

# --- Secrets ----------------------------------------------------------------
# openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_64_CHAR_RANDOM_SECRET
VIDEO_KEY_MASTER=CHANGE_ME_64_CHAR_VIDEO_MASTER_KEY
DEV_LOGIN=false

# --- Local video storage ----------------------------------------------------
STORAGE_DIR=/app/storage/videos

# --- Payments ---------------------------------------------------------------
PAYMENT_PROVIDERS=stars

# --- Observability ----------------------------------------------------------
SENTRY_DSN=

# --- Reverse proxy binding --------------------------------------------------
WEB_BIND=127.0.0.1
WEB_PORT=3000

# --- Optional Caddy profile -------------------------------------------------
SITE_DOMAIN=CHANGE_ME.example
ACME_EMAIL=admin@CHANGE_ME.example
