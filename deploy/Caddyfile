# Optional reverse proxy for docker-compose.prod.yml (profile: proxy).
# Set SITE_DOMAIN and ACME_EMAIL in .env, then run:
#   docker compose -f docker-compose.prod.yml --profile proxy up -d
{
	email {$ACME_EMAIL}
}

{$SITE_DOMAIN} {
	encode zstd gzip
	reverse_proxy web:3000

	header {
		-Server
	}
}
